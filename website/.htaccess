# SyncMe — force HTTPS (Xneelo / Apache + Let's Encrypt)
# 1. Enable Free SSL (Let's Encrypt) for the domain in Xneelo ClientZone / cPanel first.
# 2. Upload this file to the site document root (same folder as index.html).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS (keep host + path + query)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# After HTTPS works everywhere, you can uncomment the next line (1 year HSTS):
# Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
